#include <Arduino.h>
#include <TFT_eSPI.h>
#include <SPIFFS.h>
#include <TJpg_Decoder.h>
#include <Ultrasonic.h>

TFT_eSPI tft = TFT_eSPI();

// ── Color Palette ────────────────────────────────────────
#define PIP_BRIGHT   0x07E0
#define PIP_MID      0x03E0
#define PIP_DIM      0x0380
#define PIP_DARK     0x0200
#define PIP_DARKEST  0x0100
#define PIP_BLACK    0x0000
#define PIP_AMBER    0xFD20
#define PIP_RED      0xF800
#define PIP_YELLOW   0xFFE0

// ── Layout Constants ─────────────────────────────────────
#define SCREEN_W     320
#define SCREEN_H     240
#define TAB_H        36
#define BOTTOM_H     28
#define CONTENT_Y    (TAB_H + 1)
#define CONTENT_H    (SCREEN_H - TAB_H - BOTTOM_H - 0)
#define CONTENT_BOT  (SCREEN_H - BOTTOM_H - 1)

// ── Touch Calibration Switch ───────────────────────────────
// Set to 1 to run touch calibration on startup.
// Set to 0 to skip calibration and use hard-coded / preconfigured touch settings.
#define TOUCH_CALIBRATION_ENABLED 0

// When calibration is disabled, replace these values with the C0..C4 output
// from the touchscreen calibration run.
#define TOUCH_CALIBRATION_VALUES { 310, 3518, 345, 3469, 6 }

#define TRIG_PIN 21
#define ECHO_PIN 22

// ── Tabs ─────────────────────────────────────────────────
const char* TAB_LABELS[] = { "RADAR", "STAT", "TIMER", "PHOTO", "GAME", "PAINT", "DIST" };
const int   TAB_COUNT    = 7;
const int   MAX_VISIBLE_TABS = 4;
const int   TAB_ARROW_W = 24;
int tabOffset = 0;
int activeTab = 0;

bool hasTabNavigation();
int getVisibleTabCount();
int getTabWidth();
int getTabAreaX();
void drawTabArrow(int x, bool left, bool enabled);
void ensureTabVisible(int tab);

static Ultrasonic sonar(TRIG_PIN, ECHO_PIN);

// ── Radar animation ──────────────────────────────────────
unsigned long lastRadarUpdate = 0;
int radarSweepAngle = 0;
int prevSweepAngle = -1;       // ADD THIS
float prevRadarDist = -999.0f; // ADD THIS
bool radarBaseDrawn = false;   // ADD THIS

// ── Uptime ───────────────────────────────────────────────
unsigned long bootTime = 0;

// ── Stopwatch state ───────────────────────────────────────
unsigned long swStart   = 0;
unsigned long swElapsed = 0;
bool          swRunning = false;

// ── Timer button layout ───────────────────────────────────
#define BTN_Y       (CONTENT_BOT - 52)
#define BTN_H       44
#define BTN_W       90
#define BTN_START_X 10
#define BTN_STOP_X  115
#define BTN_RESET_X 220

// ── Draw tab clear button ─────────────────────────────────
#define CLEAR_X     (SCREEN_W - 70)
#define CLEAR_Y     (CONTENT_BOT - 30)
#define CLEAR_W     64
#define CLEAR_H     24

// ── Tic Tac Toe ───────────────────────────────────────────
// Board is 3x3, centered in content area
#define TTT_SIZE     44          // each cell size
#define TTT_MARGIN   10          // margin from symbol to cell edge
#define TTT_BOARD_W  (TTT_SIZE * 3)
#define TTT_BOARD_X  ((SCREEN_W - TTT_BOARD_W) / 2)   // centered X = 81
#define TTT_BOARD_Y  (CONTENT_Y + 28)                  // below title

int   tttBoard[9];    // 0=empty, 1=X (player), 2=O (CPU)
bool  tttGameOver  = false;
int   tttWinner    = 0;   // 0=none, 1=X, 2=O, 3=draw
bool  tttPlayerTurn = true;

// ── SPIFFS image list ────────────────────────────────────
String imageList[20];
int IMAGE_COUNT  = 0;
int currentImage = 0;

unsigned long lastDistanceUpdate = 0;
float        lastDistanceCM     = -1.0f;

// ── TJpg callbacks ───────────────────────────────────────
bool tft_output_fullsize(int16_t x, int16_t y, uint16_t w, uint16_t h, uint16_t* bitmap) {
  if (y >= tft.height() || x >= tft.width()) return false;
  tft.startWrite();
  tft.setAddrWindow(x, y, w, h);
  tft.pushColors(bitmap, w * h, false);
  tft.endWrite();
  return true;
}

bool tft_output(int16_t x, int16_t y, uint16_t w, uint16_t h, uint16_t* bitmap) {
  if (y + h <= CONTENT_Y) return true;
  if (y >= CONTENT_BOT)   return false;
  if (x >= SCREEN_W)      return false;
  tft.startWrite();
  tft.setAddrWindow(x, y, w, h);
  tft.pushColors(bitmap, w * h, false);
  tft.endWrite();
  return true;
}

// ── Calibration ──────────────────────────────────────────
uint16_t calData[5];

void calibrateTouch() {
  tft.fillScreen(PIP_BLACK);
  tft.setTextColor(PIP_BRIGHT, PIP_BLACK);
  tft.drawCentreString("MAKER CAI PROJECT", 160, 70, 4);
  tft.drawCentreString("TOUCH CALIBRATION", 160, 110, 2);
  tft.drawCentreString("TAP EACH MARKER ACCURATELY", 160, 130, 2);
  delay(1500);
  tft.calibrateTouch(calData, PIP_BRIGHT, PIP_BLACK, 15);
  tft.setTouch(calData);

  Serial.printf("Touch calibration values: %u %u %u %u %u\n",
                calData[0], calData[1], calData[2], calData[3], calData[4]);

  tft.fillScreen(PIP_BLACK);
  tft.setTextColor(PIP_BRIGHT, PIP_BLACK);
  tft.drawCentreString("CALIBRATION COMPLETE", 160, 20, 2);
  tft.setTextColor(PIP_DIM, PIP_BLACK);
  tft.drawCentreString("WRITE DOWN THESE VALUES", 160, 46, 2);

  char buf[32];
  for (int i = 0; i < 5; i++) {
    sprintf(buf, "C%d: %u", i, calData[i]);
    tft.drawString(buf, 20, 74 + i * 24, 2);
  }

  tft.setTextColor(PIP_BRIGHT, PIP_BLACK);
  tft.drawCentreString("TOUCH SCREEN TO CONTINUE", 160, CONTENT_BOT - 16, 1);

  uint16_t tx = 0, ty = 0;
  while (!tft.getTouch(&tx, &ty)) {
    delay(50);
  }
  delay(300);
}

// ── Draw Tab Bar ─────────────────────────────────────────
void drawTabs() {
  tft.fillRect(0, 0, SCREEN_W, TAB_H, PIP_BLACK);
  bool nav = hasTabNavigation();
  int visibleCount = getVisibleTabCount();
  int tabW = getTabWidth();
  int areaX = getTabAreaX();

  if (nav) {
    drawTabArrow(0, true, tabOffset > 0);
    drawTabArrow(SCREEN_W - TAB_ARROW_W, false, tabOffset + visibleCount < TAB_COUNT);
  }

  for (int i = 0; i < visibleCount; i++) {
    int tabIndex = tabOffset + i;
    int x = areaX + i * tabW;
    bool active = (tabIndex == activeTab);
    if (active) {
      tft.fillRect(x + 1, 1, tabW - 2, TAB_H - 1, PIP_DARK);
      tft.drawRect(x + 1, 1, tabW - 2, TAB_H - 1, PIP_BRIGHT);
      tft.drawFastHLine(x + 2, 1, tabW - 4, PIP_BRIGHT);
      tft.setTextColor(PIP_BRIGHT, PIP_DARK);
    } else {
      tft.fillRect(x + 1, 3, tabW - 2, TAB_H - 3, PIP_BLACK);
      tft.drawRect(x + 1, 3, tabW - 2, TAB_H - 3, PIP_DARKEST);
      tft.setTextColor(PIP_DIM, PIP_BLACK);
    }
    int labelX = x + tabW / 2;
    int labelY = active ? 11 : 13;
    tft.drawCentreString(TAB_LABELS[tabIndex], labelX, labelY, 2);
    if (i < visibleCount - 1) {
      tft.drawFastVLine(x + tabW, 2, TAB_H - 4, PIP_DARK);
    }
  }
  tft.drawFastHLine(0, TAB_H, SCREEN_W, PIP_MID);
  tft.drawFastHLine(0, TAB_H - 1, SCREEN_W, PIP_DARK);
  int ax = areaX + (activeTab - tabOffset) * tabW;
  tft.drawFastHLine(ax + 1, TAB_H - 1, tabW - 2, PIP_BRIGHT);
}

// ── Draw Bottom Bar ───────────────────────────────────────
void drawBottomBar() {
  tft.drawFastHLine(0, CONTENT_BOT, SCREEN_W, PIP_MID);
  tft.drawFastHLine(0, CONTENT_BOT + 1, SCREEN_W, PIP_DARK);
  tft.fillRect(0, CONTENT_BOT + 2, SCREEN_W, BOTTOM_H, PIP_BLACK);
  tft.setTextColor(PIP_MID, PIP_BLACK);
  tft.drawString(">>", 2, CONTENT_BOT + 8, 2);
  tft.setTextColor(PIP_BRIGHT, PIP_BLACK);
  tft.drawString("PIP-BOY ", 16, CONTENT_BOT + 8, 2);
  tft.drawString(" * MAKER CAI *", 70, CONTENT_BOT + 8, 2);
}

bool hasTabNavigation() {
  return TAB_COUNT > MAX_VISIBLE_TABS;
}

int getVisibleTabCount() {
  return min(TAB_COUNT, MAX_VISIBLE_TABS);
}

int getTabWidth() {
  int visible = getVisibleTabCount();
  int area = SCREEN_W - (hasTabNavigation() ? TAB_ARROW_W * 2 : 0);
  return area / visible;
}

int getTabAreaX() {
  return hasTabNavigation() ? TAB_ARROW_W : 0;
}

void drawTabArrow(int x, bool left, bool enabled) {
  uint16_t fill = enabled ? PIP_DARK : PIP_BLACK;
  uint16_t border = enabled ? PIP_BRIGHT : PIP_DARKEST;
  uint16_t color = enabled ? PIP_BRIGHT : PIP_DIM;
  tft.fillRect(x, 0, TAB_ARROW_W, TAB_H, fill);
  tft.drawRect(x, 0, TAB_ARROW_W - 1, TAB_H - 1, border);
  tft.setTextColor(color, fill);
  tft.drawCentreString(left ? "<" : ">", x + TAB_ARROW_W / 2, 10, 4);
}

void ensureTabVisible(int tab) {
  if (!hasTabNavigation()) return;
  if (tab < tabOffset) {
    tabOffset = tab;
  } else if (tab >= tabOffset + getVisibleTabCount()) {
    tabOffset = tab - getVisibleTabCount() + 1;
  }
}

// ── Update Uptime ─────────────────────────────────────────
void updateUptime() {
  unsigned long up = (millis() - bootTime) / 1000;
  int h = up / 3600;
  int m = (up % 3600) / 60;
  int s = up % 60;
  char buf[12];
  sprintf(buf, "%02d:%02d:%02d", h, m, s);
  tft.fillRect(180, CONTENT_BOT + 3, 136, BOTTOM_H - 4, PIP_BLACK);
  tft.setTextColor(PIP_MID, PIP_BLACK);
  tft.drawString("UP:", 200, CONTENT_BOT + 8, 2);
  tft.setTextColor(PIP_BRIGHT, PIP_BLACK);
  tft.drawString(buf, 222, CONTENT_BOT + 8, 2);
}

// ── Draw Corner Brackets ──────────────────────────────────
void drawCornerBrackets() {
  int x1 = 4, y1 = CONTENT_Y + 4;
  int x2 = SCREEN_W - 4, y2 = CONTENT_BOT - 4;
  int len = 12;
  tft.drawFastHLine(x1, y1, len, PIP_MID);
  tft.drawFastVLine(x1, y1, len, PIP_MID);
  tft.drawFastHLine(x2 - len, y1, len, PIP_MID);
  tft.drawFastVLine(x2, y1, len, PIP_MID);
  tft.drawFastHLine(x1, y2, len, PIP_MID);
  tft.drawFastVLine(x1, y2 - len, len, PIP_MID);
  tft.drawFastHLine(x2 - len, y2, len, PIP_MID);
  tft.drawFastVLine(x2, y2 - len, len, PIP_MID);
  tft.drawPixel(x1 + len, y1 + len, PIP_DIM);
  tft.drawPixel(x2 - len, y1 + len, PIP_DIM);
  tft.drawPixel(x1 + len, y2 - len, PIP_DIM);
  tft.drawPixel(x2 - len, y2 - len, PIP_DIM);
}

// ── Draw Scanlines ────────────────────────────────────────
void drawScanlines() {
  for (int y = CONTENT_Y + 2; y < CONTENT_BOT; y += 3) {
    tft.drawFastHLine(5, y, SCREEN_W - 10, PIP_DARK);
  }
}

// ── Draw STAT Screen ─────────────────────────────────────
void drawStatScreen() {
  tft.fillRect(0, CONTENT_Y, SCREEN_W, CONTENT_H, PIP_BLACK);
  TJpgDec.setCallback(tft_output);
  TJpgDec.drawFsJpg(0, CONTENT_Y, "/vaultboy_splash.jpg");
  tft.setTextColor(PIP_BRIGHT, PIP_BLACK);
  tft.drawString("S.P.E.C.I.A.L", 10, CONTENT_Y + 8, 2);
  tft.drawFastHLine(10, CONTENT_Y + 26, 140, PIP_MID);
  const char* stats[] = { "STR", "PER", "END", "CHR", "INT", "AGI", "LCK" };
  const int   vals[]  = {  8,     7,     9,     6,     10,    7,     8   };
  for (int i = 0; i < 7; i++) {
    int y = CONTENT_Y + 34 + i * 15;
    tft.setTextColor(PIP_DIM, PIP_BLACK);
    tft.drawString(stats[i], 10, y, 1);
    int barW = vals[i] * 10;
    tft.fillRect(46, y + 1, barW, 8, PIP_DARK);
    tft.fillRect(46, y + 1, barW - 4, 6, PIP_MID);
    tft.drawRect(46, y, barW, 9, PIP_DIM);
    char vbuf[4];
    sprintf(vbuf, "%02d", vals[i]);
    tft.setTextColor(PIP_BRIGHT, PIP_BLACK);
    tft.drawString(vbuf, 150, y, 1);
  }
  tft.setTextColor(PIP_DIM, PIP_BLACK);
  tft.drawString("LVL 10  XP 2400/3000", 10, CONTENT_BOT - 24, 1);
  tft.drawRect(10, CONTENT_BOT - 14, 140, 8, PIP_DIM);
  tft.fillRect(11, CONTENT_BOT - 13, 112, 6, PIP_MID);
  drawCornerBrackets();
}

// ── Timer button draw ─────────────────────────────────────
void drawTimerButton(int x, int y, int w, int h, const char* label, bool highlight) {
  uint16_t borderCol = highlight ? PIP_BRIGHT : PIP_MID;
  uint16_t fillCol   = highlight ? PIP_DARK   : PIP_BLACK;
  uint16_t textCol   = highlight ? PIP_BRIGHT : PIP_DIM;
  tft.fillRect(x, y, w, h, fillCol);
  tft.drawRect(x, y, w, h, borderCol);
  tft.drawRect(x + 1, y + 1, w - 2, h - 2, borderCol);
  tft.setTextColor(textCol, fillCol);
  tft.drawCentreString(label, x + w / 2, y + h / 2 - 8, 2);
}

// ── Update stopwatch digits only ──────────────────────────
void updateTimerDisplay() {
  unsigned long elapsed = swRunning ? (millis() - swStart) : swElapsed;
  int mm = (elapsed / 60000) % 60;
  int ss = (elapsed / 1000)  % 60;
  int cs = (elapsed / 10)    % 100;
  char buf[12];
  sprintf(buf, "%02d:%02d:%02d", mm, ss, cs);
  int timeY = CONTENT_Y + 50;
  tft.fillRect(1, timeY, SCREEN_W - 2, 50, PIP_BLACK);
  tft.setTextColor(PIP_BRIGHT, PIP_BLACK);
  tft.setTextSize(2);
  tft.drawCentreString(buf, 160, timeY, 2);
  tft.setTextSize(1);
}

// ── Draw TIMER Screen ────────────────────────────────────
void drawTimerScreen() {
  tft.fillRect(0, CONTENT_Y, SCREEN_W, CONTENT_H, PIP_BLACK);
  tft.setTextColor(PIP_BRIGHT, PIP_BLACK);
  tft.drawCentreString("STOPWATCH", 160, CONTENT_Y + 6, 2);
  tft.drawFastHLine(40, CONTENT_Y + 22, 240, PIP_DIM);
  updateTimerDisplay();
  drawTimerButton(BTN_START_X, BTN_Y, BTN_W, BTN_H, "START", swRunning);
  drawTimerButton(BTN_STOP_X,  BTN_Y, BTN_W, BTN_H, "STOP",  false);
  drawTimerButton(BTN_RESET_X, BTN_Y, BTN_W, BTN_H, "RESET", false);
  drawCornerBrackets();
}

// ── Draw PHOTO Screen ────────────────────────────────────
void drawPhotoScreen() {
  tft.fillRect(0, CONTENT_Y, SCREEN_W, CONTENT_H, PIP_BLACK);
  if (IMAGE_COUNT == 0) {
    tft.setTextColor(PIP_DIM, PIP_BLACK);
    tft.drawCentreString("NO IMAGES FOUND", 160, CONTENT_Y + CONTENT_H / 2, 2);
  } else {
    TJpgDec.setCallback(tft_output);
    TJpgDec.drawFsJpg(0, CONTENT_Y, imageList[currentImage].c_str());
  }
  drawCornerBrackets();
}

// ═══════════════════════════════════════════════════════════
// ── TIC TAC TOE ────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════

// Draw X in a cell
void tttDrawX(int col, int row) {
  int cx = TTT_BOARD_X + col * TTT_SIZE + TTT_SIZE / 2;
  int cy = TTT_BOARD_Y + row * TTT_SIZE + TTT_SIZE / 2;
  int r  = TTT_SIZE / 2 - TTT_MARGIN;
  tft.drawLine(cx - r, cy - r, cx + r, cy + r, PIP_BRIGHT);
  tft.drawLine(cx - r, cy - r + 1, cx + r, cy + r + 1, PIP_BRIGHT); // thicker
  tft.drawLine(cx + r, cy - r, cx - r, cy + r, PIP_BRIGHT);
  tft.drawLine(cx + r, cy - r + 1, cx - r, cy + r + 1, PIP_BRIGHT); // thicker
}

// Draw O in a cell
void tttDrawO(int col, int row) {
  int cx = TTT_BOARD_X + col * TTT_SIZE + TTT_SIZE / 2;
  int cy = TTT_BOARD_Y + row * TTT_SIZE + TTT_SIZE / 2;
  int r  = TTT_SIZE / 2 - TTT_MARGIN;
  tft.drawCircle(cx, cy, r,     PIP_MID);
  tft.drawCircle(cx, cy, r - 1, PIP_MID); // thicker
}

// Draw the grid lines
void tttDrawGrid() {
  for (int i = 1; i < 3; i++) {
    // Vertical lines
    tft.drawFastVLine(TTT_BOARD_X + i * TTT_SIZE,     TTT_BOARD_Y, TTT_SIZE * 3, PIP_MID);
    tft.drawFastVLine(TTT_BOARD_X + i * TTT_SIZE + 1, TTT_BOARD_Y, TTT_SIZE * 3, PIP_DIM);
    // Horizontal lines
    tft.drawFastHLine(TTT_BOARD_X, TTT_BOARD_Y + i * TTT_SIZE,     TTT_SIZE * 3, PIP_MID);
    tft.drawFastHLine(TTT_BOARD_X, TTT_BOARD_Y + i * TTT_SIZE + 1, TTT_SIZE * 3, PIP_DIM);
  }
}

// Draw all pieces on the board
void tttDrawBoard() {
  for (int i = 0; i < 9; i++) {
    int col = i % 3;
    int row = i / 3;
    if (tttBoard[i] == 1) tttDrawX(col, row);
    if (tttBoard[i] == 2) tttDrawO(col, row);
  }
}

// Draw status text
void tttDrawStatus() {
  tft.fillRect(0, CONTENT_Y, SCREEN_W, 26, PIP_BLACK);
  tft.setTextColor(PIP_BRIGHT, PIP_BLACK);
  tft.drawCentreString("TIC TAC TOE", 160, CONTENT_Y + 4, 2);

  // Right side: turn / result indicator
  tft.fillRect(TTT_BOARD_X + TTT_BOARD_W + 5, TTT_BOARD_Y, 60, TTT_SIZE * 3, PIP_BLACK);
  tft.setTextColor(PIP_DIM, PIP_BLACK);

  if (!tttGameOver) {
    if (tttPlayerTurn) {
      tft.drawCentreString("YOUR",  TTT_BOARD_X + TTT_BOARD_W + 35, TTT_BOARD_Y + 20, 1);
      tft.drawCentreString("TURN",  TTT_BOARD_X + TTT_BOARD_W + 35, TTT_BOARD_Y + 32, 1);
      tft.setTextColor(PIP_BRIGHT, PIP_BLACK);
      tft.drawCentreString("X",     TTT_BOARD_X + TTT_BOARD_W + 35, TTT_BOARD_Y + 48, 4);
    } else {
      tft.drawCentreString("CPU",   TTT_BOARD_X + TTT_BOARD_W + 35, TTT_BOARD_Y + 20, 1);
      tft.drawCentreString("TURN",  TTT_BOARD_X + TTT_BOARD_W + 35, TTT_BOARD_Y + 32, 1);
      tft.setTextColor(PIP_MID, PIP_BLACK);
      tft.drawCentreString("O",     TTT_BOARD_X + TTT_BOARD_W + 35, TTT_BOARD_Y + 48, 4);
    }
  } else {
    tft.setTextColor(PIP_BRIGHT, PIP_BLACK);
    if (tttWinner == 1)      tft.drawCentreString("YOU\nWIN!",  TTT_BOARD_X + TTT_BOARD_W + 35, TTT_BOARD_Y + 20, 2);
    else if (tttWinner == 2) tft.drawCentreString("CPU\nWINS",  TTT_BOARD_X + TTT_BOARD_W + 35, TTT_BOARD_Y + 20, 2);
    else                     tft.drawCentreString("DRAW",       TTT_BOARD_X + TTT_BOARD_W + 35, TTT_BOARD_Y + 30, 2);
  }
}

// Draw NEW GAME button
void tttDrawNewGame() {
  int bx = TTT_BOARD_X + TTT_BOARD_W + 5;
  int by = TTT_BOARD_Y + TTT_SIZE * 3 - 24;
  tft.fillRect(bx, by, 58, 22, PIP_BLACK);
  tft.drawRect(bx, by, 58, 22, PIP_MID);
  tft.setTextColor(PIP_DIM, PIP_BLACK);
  tft.drawCentreString("NEW", bx + 29, by + 3, 1);
  tft.drawCentreString("GAME", bx + 29, by + 12, 1);
}

// Check winner — returns 1 (X wins), 2 (O wins), 3 (draw), 0 (ongoing)
int tttCheckWinner() {
  int wins[8][3] = {
    {0,1,2},{3,4,5},{6,7,8},  // rows
    {0,3,6},{1,4,7},{2,5,8},  // cols
    {0,4,8},{2,4,6}           // diagonals
  };
  for (int w = 0; w < 8; w++) {
    int a = tttBoard[wins[w][0]];
    int b = tttBoard[wins[w][1]];
    int c = tttBoard[wins[w][2]];
    if (a && a == b && b == c) return a;
  }
  for (int i = 0; i < 9; i++) if (tttBoard[i] == 0) return 0;
  return 3; // draw
}

// Draw winning line
void tttDrawWinLine() {
  int wins[8][3] = {
    {0,1,2},{3,4,5},{6,7,8},
    {0,3,6},{1,4,7},{2,5,8},
    {0,4,8},{2,4,6}
  };
  for (int w = 0; w < 8; w++) {
    int a = tttBoard[wins[w][0]];
    int b = tttBoard[wins[w][1]];
    int c = tttBoard[wins[w][2]];
    if (a && a == b && b == c) {
      int i1 = wins[w][0], i3 = wins[w][2];
      int x1 = TTT_BOARD_X + (i1 % 3) * TTT_SIZE + TTT_SIZE / 2;
      int y1 = TTT_BOARD_Y + (i1 / 3) * TTT_SIZE + TTT_SIZE / 2;
      int x2 = TTT_BOARD_X + (i3 % 3) * TTT_SIZE + TTT_SIZE / 2;
      int y2 = TTT_BOARD_Y + (i3 / 3) * TTT_SIZE + TTT_SIZE / 2;
      tft.drawLine(x1, y1, x2, y2, PIP_AMBER);
      tft.drawLine(x1, y1 + 1, x2, y2 + 1, PIP_AMBER);
      return;
    }
  }
}

// Simple CPU move — picks center, then corners, then random
void tttCpuMoveSmart() {
  // Try to win
  for (int i = 0; i < 9; i++) {
    if (tttBoard[i] == 0) {
      tttBoard[i] = 2;
      if (tttCheckWinner() == 2) return;
      tttBoard[i] = 0;
    }
  }
  // Block player
  for (int i = 0; i < 9; i++) {
    if (tttBoard[i] == 0) {
      tttBoard[i] = 1;
      if (tttCheckWinner() == 1) { tttBoard[i] = 2; return; }
      tttBoard[i] = 0;
    }
  }
  // Take center
  if (tttBoard[4] == 0) { tttBoard[4] = 2; return; }
  // Take a corner
  int corners[] = {0, 2, 6, 8};
  for (int c : corners) if (tttBoard[c] == 0) { tttBoard[c] = 2; return; }
  // Take any empty
  for (int i = 0; i < 9; i++) if (tttBoard[i] == 0) { tttBoard[i] = 2; return; }
}

// Dumber CPU move — just picks the first empty cell it finds
void tttCpuMove() {
  // 40% chance to make a random move instead of smart move
  int r = random(10);
  if (r < 4) {
    // Random empty cell
    int attempts = 0;
    while (attempts < 20) {
      int i = random(9);
      if (tttBoard[i] == 0) { tttBoard[i] = 2; return; }
      attempts++;
    }
  }

  // Block player win (only sometimes — 60% chance)
  if (random(10) < 6) {
    for (int i = 0; i < 9; i++) {
      if (tttBoard[i] == 0) {
        tttBoard[i] = 1;
        if (tttCheckWinner() == 1) { tttBoard[i] = 2; return; }
        tttBoard[i] = 0;
      }
    }
  }

  // Take any empty cell — no strategy
  for (int i = 0; i < 9; i++) {
    if (tttBoard[i] == 0) { tttBoard[i] = 2; return; }
  }
}

// Reset the game
void tttNewGame() {
  for (int i = 0; i < 9; i++) tttBoard[i] = 0;
  tttGameOver   = false;
  tttWinner     = 0;
  tttPlayerTurn = true;
}

// Full draw of game screen
void drawGameScreen() {
  tft.fillRect(0, CONTENT_Y, SCREEN_W, CONTENT_H, PIP_BLACK);
  tttDrawGrid();
  tttDrawBoard();
  tttDrawStatus();
  tttDrawNewGame();
  drawCornerBrackets();
}

// ── Draw CLEAR button for draw screen ────────────────────
void drawClearButton() {
  tft.fillRect(CLEAR_X, CLEAR_Y, CLEAR_W, CLEAR_H, PIP_BLACK);
  tft.drawRect(CLEAR_X, CLEAR_Y, CLEAR_W, CLEAR_H, PIP_MID);
  tft.drawRect(CLEAR_X + 1, CLEAR_Y + 1, CLEAR_W - 2, CLEAR_H - 2, PIP_MID);
  tft.setTextColor(PIP_DIM, PIP_BLACK);
  tft.drawCentreString("CLEAR", CLEAR_X + CLEAR_W / 2, CLEAR_Y + CLEAR_H / 2 - 5, 1);
}

// ── Draw DRAW Screen ─────────────────────────────────────
float readDistanceCM() {
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);
  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);

  unsigned long rawPulse = pulseIn(ECHO_PIN, HIGH, 20000UL);
  int echoState = digitalRead(ECHO_PIN);
  Serial.printf("Ultrasonic debug: TRIG=%d ECHO_before=%d pulse_us=%lu ECHO_after=%d\n",
                digitalRead(TRIG_PIN), echoState, rawPulse, digitalRead(ECHO_PIN));

  if (rawPulse == 0) {
    Serial.println("Ultrasonic: NO ECHO / timeout");
    return -1.0f;
  }

  float dist = rawPulse / 58.0f;
  Serial.printf("Ultrasonic: raw distance=%.1fcm\n", dist);
  return dist;
}

void updateDistanceDisplay() {
  lastDistanceCM = readDistanceCM();
  tft.fillRect(0, CONTENT_Y + 30, SCREEN_W, 100, PIP_BLACK);
  tft.setTextColor(PIP_BRIGHT, PIP_BLACK);
  if (lastDistanceCM < 0.0f) {
    tft.drawCentreString("NO ECHO", 160, CONTENT_Y + 70, 4);
  } else {
    char buf[16];
    sprintf(buf, "%.1f CM", lastDistanceCM);
    tft.drawCentreString(buf, 160, CONTENT_Y + 70, 4);
  }
}

void drawDistScreen() {
  tft.fillRect(0, CONTENT_Y, SCREEN_W, CONTENT_H, PIP_BLACK);
  tft.setTextColor(PIP_DIM, PIP_BLACK);
  tft.drawCentreString("ULTRASONIC", 160, CONTENT_Y + 6, 2);
  tft.drawFastHLine(40, CONTENT_Y + 22, 240, PIP_DIM);
  updateDistanceDisplay();
  drawCornerBrackets();
}

// ── Draw static RADAR base (called once on tab switch) ───
void drawRadarBase() {
  tft.fillRect(0, CONTENT_Y, SCREEN_W, CONTENT_H, PIP_BLACK);
  tft.setTextColor(PIP_BRIGHT, PIP_BLACK);
  tft.drawCentreString("RADAR", 160, CONTENT_Y + 6, 2);
  tft.drawFastHLine(40, CONTENT_Y + 22, 240, PIP_DIM);

  int radarCX = 160;
  int radarCY = CONTENT_Y + 90;
  int radarRadius = 50;

  tft.drawCircle(radarCX, radarCY, radarRadius,     PIP_DIM);
  tft.drawCircle(radarCX, radarCY, radarRadius / 2, PIP_DARK);
  tft.drawFastVLine(radarCX, radarCY - radarRadius, radarRadius * 2, PIP_DARK);
  tft.drawFastHLine(radarCX - radarRadius, radarCY,  radarRadius * 2, PIP_DARK);

  drawCornerBrackets();
  radarBaseDrawn = true;
}

// ── Incremental RADAR update (called every 50ms) ─────────
void updateRadarScreen() {
  int radarCX = 160;
  int radarCY = CONTENT_Y + 90;
  int radarRadius = 50;

  // Erase old sweep line
  if (prevSweepAngle >= 0) {
    int ox = radarCX + (int)(radarRadius * cos((prevSweepAngle - 90) * 3.14159f / 180.0f));
    int oy = radarCY + (int)(radarRadius * sin((prevSweepAngle - 90) * 3.14159f / 180.0f));
    tft.drawLine(radarCX, radarCY, ox, oy, PIP_BLACK);

    // Restore any grid lines the erase may have clobbered
    tft.drawCircle(radarCX, radarCY, radarRadius,     PIP_DIM);
    tft.drawCircle(radarCX, radarCY, radarRadius / 2, PIP_DARK);
    tft.drawFastVLine(radarCX, radarCY - radarRadius, radarRadius * 2, PIP_DARK);
    tft.drawFastHLine(radarCX - radarRadius, radarCY,  radarRadius * 2, PIP_DARK);
  }

  // Erase old object dot
  if (prevRadarDist > 0.0f) {
    float oldR = radarRadius * (prevRadarDist / 150.0f);
    if (oldR > radarRadius) oldR = radarRadius - 2;
    int ox = radarCX + (int)(oldR * cos((prevSweepAngle - 90) * 3.14159f / 180.0f));
    int oy = radarCY + (int)(oldR * sin((prevSweepAngle - 90) * 3.14159f / 180.0f));
    tft.fillCircle(ox, oy, 4, PIP_BLACK);
  }

  // Read distance
  float currentDist = readDistanceCM();

  // Draw new sweep line
  int sx = radarCX + (int)(radarRadius * cos((radarSweepAngle - 90) * 3.14159f / 180.0f));
  int sy = radarCY + (int)(radarRadius * sin((radarSweepAngle - 90) * 3.14159f / 180.0f));
  tft.drawLine(radarCX, radarCY, sx, sy, PIP_BRIGHT);

  // Draw new object dot
  if (currentDist > 0.0f) {
    uint16_t objectColor = (currentDist <= 50.0f) ? PIP_RED
                         : (currentDist <= 100.0f) ? PIP_YELLOW
                         : PIP_BRIGHT;
    float objR = radarRadius * (currentDist / 150.0f);
    if (objR > radarRadius) objR = radarRadius - 2;
    int ox = radarCX + (int)(objR * cos((radarSweepAngle - 90) * 3.14159f / 180.0f));
    int oy = radarCY + (int)(objR * sin((radarSweepAngle - 90) * 3.14159f / 180.0f));
    tft.fillCircle(ox, oy, 4, objectColor);
  }

  // Update zone/distance label (erase then redraw)
  tft.fillRect(0, CONTENT_BOT - 20, SCREEN_W, 20, PIP_BLACK);
  if (currentDist > 0.0f) {
    char distBuf[16];
    sprintf(distBuf, "%.1f cm", currentDist);

    uint16_t zoneColor = (currentDist <= 25.0f)  ? PIP_RED
                       : (currentDist <= 50.0f) ? PIP_YELLOW
                       : PIP_BRIGHT;
    const char* zoneLabel = (currentDist <= 25.0f)  ? "RED ZONE"
                           : (currentDist <= 50.0f) ? "YELLOW ZONE"
                           : "GREEN ZONE";
    tft.setTextColor(zoneColor, PIP_BLACK);
    tft.drawString(zoneLabel, 20, CONTENT_BOT - 16, 2);
    tft.setTextColor(PIP_DIM, PIP_BLACK);
    tft.drawString("DIST:", 220, CONTENT_BOT - 16, 2);
    tft.setTextColor(PIP_BRIGHT, PIP_BLACK);
    tft.drawString(distBuf, 250, CONTENT_BOT - 16, 2);
  } else {
    tft.setTextColor(PIP_DIM, PIP_BLACK);
    tft.drawString("No target", 20, CONTENT_BOT - 16, 2);
  }

  prevSweepAngle = radarSweepAngle;
  prevRadarDist  = currentDist;
}

// ── drawRadarScreen() now just draws the base (for tab switch) ──
void drawRadarScreen() {
  drawRadarBase();
  prevSweepAngle = -1;
  prevRadarDist  = -999.0f;
}

// ── Draw DRAW Screen ─────────────────────────────────────
void drawDrawScreen() {
  tft.fillRect(0, CONTENT_Y, SCREEN_W, CONTENT_H, PIP_BLACK);
  tft.setTextColor(PIP_DIM, PIP_BLACK);
  tft.drawCentreString("DRAWING PAD", 160, CONTENT_Y + 6, 2);
  tft.drawFastHLine(40, CONTENT_Y + 22, 240, PIP_DIM);
  drawClearButton();
  drawCornerBrackets();
}

// ── Draw Active Screen ────────────────────────────────────
void drawActiveScreen() {
  switch (activeTab) {
    case 0: drawRadarScreen(); break;
    case 1: drawStatScreen();  break;
    case 2: drawTimerScreen(); break;
    case 3: drawPhotoScreen(); break;
    case 4: drawGameScreen();  break;
    case 5: drawDrawScreen();  break;
    case 6: drawDistScreen();  break;
    
  }
}

// ── Full Redraw ───────────────────────────────────────────
void drawAll() {
  tft.fillScreen(PIP_BLACK);
  tft.drawRect(0, 0, SCREEN_W, SCREEN_H, PIP_MID);
  drawTabs();
  drawBottomBar();
  updateUptime();
  drawActiveScreen();
}

// ── SPIFFS scan ───────────────────────────────────────────
void buildImageList() {
  File root = SPIFFS.open("/");
  File file = root.openNextFile();
  while (file && IMAGE_COUNT < 20) {
    String name = String(file.name());
    if (name.endsWith(".jpg") || name.endsWith(".JPG")) {
      if (!name.startsWith("/")) name = "/" + name;
      imageList[IMAGE_COUNT++] = name;
    }
    file = root.openNextFile();
  }
  Serial.printf("Found %d images\n", IMAGE_COUNT);
}

// ─────────────────────────────────────────────────────────
void setup() {
  Serial.begin(115200);
  tft.init();
  tft.setRotation(3); // landscape with USB port on the right
  tft.invertDisplay(false);
  tft.fillScreen(PIP_BLACK);
  pinMode(27, OUTPUT);
  digitalWrite(27, HIGH);
  pinMode(TRIG_PIN, OUTPUT);
  digitalWrite(TRIG_PIN, LOW);
  pinMode(ECHO_PIN, INPUT_PULLDOWN);
  Serial.printf("Ultrasonic TRIG=%d ECHO=%d, ECHO init=%d\n", TRIG_PIN, ECHO_PIN, digitalRead(ECHO_PIN));
  if (!SPIFFS.begin(true)) {
    Serial.println("SPIFFS failed");
  } else {
    TJpgDec.setCallback(tft_output);
    TJpgDec.setSwapBytes(true);
    buildImageList();
  }

#if TOUCH_CALIBRATION_ENABLED
  calibrateTouch();
#else
  const uint16_t TOUCH_CAL[5] = TOUCH_CALIBRATION_VALUES;
  memcpy(calData, TOUCH_CAL, sizeof(calData));
  tft.setTouch(calData);
  Serial.printf("Touch calibration hard-coded values: %u %u %u %u %u\n",
                calData[0], calData[1], calData[2], calData[3], calData[4]);
#endif

  tttNewGame();
  bootTime = millis();
  drawAll();
}

// ─────────────────────────────────────────────────────────
unsigned long lastUptimeUpdate = 0;
unsigned long lastTimerUpdate  = 0;

void loop() {
  if (millis() - lastUptimeUpdate > 1000) {
    lastUptimeUpdate = millis();
    updateUptime();
  }
  if (activeTab == 2 && swRunning && millis() - lastTimerUpdate > 50) {
    lastTimerUpdate = millis();
    updateTimerDisplay();
  }

  if (activeTab == 6 && millis() - lastDistanceUpdate > 200) {
    lastDistanceUpdate = millis();
    updateDistanceDisplay();
  }

  if (activeTab == 0 && millis() - lastRadarUpdate > 50) {
    lastRadarUpdate = millis();
    radarSweepAngle = (radarSweepAngle + 6) % 360;
    updateRadarScreen();   // ← changed from drawRadarScreen()
  }

  uint16_t t_x = 0, t_y = 0;
  bool pressed = tft.getTouch(&t_x, &t_y);

  if (pressed) {
    Serial.printf("Touch X: %d Y: %d\n", t_x, t_y);

    // ── Tab bar ──
    if (t_y < TAB_H) {
      bool nav = hasTabNavigation();
      int visibleCount = getVisibleTabCount();
      int tabW = getTabWidth();
      int areaX = getTabAreaX();

      if (nav && t_x < TAB_ARROW_W) {
        if (tabOffset > 0) {
          tabOffset--;
          drawTabs();
        }
        return;
      }
      if (nav && t_x >= SCREEN_W - TAB_ARROW_W) {
        if (tabOffset + visibleCount < TAB_COUNT) {
          tabOffset++;
          drawTabs();
        }
        return;
      }

      int tappedTab = (t_x - areaX) / tabW;
      if (tappedTab >= 0 && tappedTab < visibleCount) {
        int newTab = tabOffset + tappedTab;
        if (newTab != activeTab) {
          activeTab = newTab;
          ensureTabVisible(activeTab);
          drawTabs();
          drawActiveScreen();
        }
      }
      return;
    }

    // ── Timer buttons ──
    if (activeTab == 1 && t_y >= BTN_Y && t_y <= BTN_Y + BTN_H) {
      if (t_x >= BTN_START_X && t_x <= BTN_START_X + BTN_W) {
        if (!swRunning) {
          swRunning = true;
          swStart   = millis() - swElapsed;
          drawTimerButton(BTN_START_X, BTN_Y, BTN_W, BTN_H, "START", true);
        }
      } else if (t_x >= BTN_STOP_X && t_x <= BTN_STOP_X + BTN_W) {
        if (swRunning) {
          swElapsed = millis() - swStart;
          swRunning = false;
          drawTimerButton(BTN_START_X, BTN_Y, BTN_W, BTN_H, "START", false);
          drawTimerButton(BTN_STOP_X,  BTN_Y, BTN_W, BTN_H, "STOP",  true);
          delay(150);
          drawTimerButton(BTN_STOP_X,  BTN_Y, BTN_W, BTN_H, "STOP",  false);
        }
      } else if (t_x >= BTN_RESET_X && t_x <= BTN_RESET_X + BTN_W) {
        swRunning = false;
        swElapsed = 0;
        swStart   = millis();
        drawTimerButton(BTN_RESET_X, BTN_Y, BTN_W, BTN_H, "RESET", true);
        delay(150);
        drawTimerScreen();
      }
      return;
    }

    // ── PHOTO — tap to advance ──
    if (activeTab == 2 && t_y >= CONTENT_Y && t_y < CONTENT_BOT && IMAGE_COUNT > 0) {
      while (tft.getTouch(&t_x, &t_y)) delay(10);
      currentImage = (currentImage + 1) % IMAGE_COUNT;
      drawPhotoScreen();
      return;
    }

    // ── GAME — Tic Tac Toe ──
    if (activeTab == 3) {
      // NEW GAME button
      int bx = TTT_BOARD_X + TTT_BOARD_W + 5;
      int by = TTT_BOARD_Y + TTT_SIZE * 3 - 24;
      if (t_x >= bx && t_x <= bx + 58 && t_y >= by && t_y <= by + 22) {
        tttNewGame();
        drawGameScreen();
        delay(150);
        return;
      }

      // Board tap — player move
      if (!tttGameOver && tttPlayerTurn &&
          t_x >= TTT_BOARD_X && t_x < TTT_BOARD_X + TTT_BOARD_W &&
          t_y >= TTT_BOARD_Y && t_y < TTT_BOARD_Y + TTT_SIZE * 3) {
        int col = (t_x - TTT_BOARD_X) / TTT_SIZE;
        int row = (t_y - TTT_BOARD_Y) / TTT_SIZE;
        int idx = row * 3 + col;
        if (tttBoard[idx] == 0) {
          tttBoard[idx]  = 1;
          tttPlayerTurn  = false;
          tttDrawX(col, row);

          int result = tttCheckWinner();
          if (result) {
            tttGameOver = true;
            tttWinner   = result;
            if (result == 1 || result == 2) tttDrawWinLine();
            tttDrawStatus();
            tttDrawNewGame();
            delay(150);
            return;
          }

          // CPU move
          tttDrawStatus();
          delay(300);
          tttCpuMove();
          tttPlayerTurn = true;

          // Redraw board to show CPU move
          tttDrawGrid();
          tttDrawBoard();

          result = tttCheckWinner();
          if (result) {
            tttGameOver = true;
            tttWinner   = result;
            if (result == 1 || result == 2) tttDrawWinLine();
          }
          tttDrawStatus();
          tttDrawNewGame();
        }
        delay(150);
        return;
      }
    }

    // ── PAINT — drawing ──
    if (activeTab == 4 && t_y >= CONTENT_Y && t_y < CONTENT_BOT) {
      // Check if clear button pressed
      if (t_x >= CLEAR_X && t_x <= CLEAR_X + CLEAR_W && t_y >= CLEAR_Y && t_y <= CLEAR_Y + CLEAR_H) {
        // Clear the drawing area
        tft.fillRect(0, CONTENT_Y, SCREEN_W, CONTENT_H, PIP_BLACK);
        tft.setTextColor(PIP_DIM, PIP_BLACK);
        tft.drawCentreString("DRAWING PAD", 160, CONTENT_Y + 6, 2);
        tft.drawFastHLine(40, CONTENT_Y + 22, 240, PIP_DIM);
        drawClearButton();
        drawCornerBrackets();
      } else {
        // Draw circle at touch point
        tft.fillCircle(t_x, t_y, 3, PIP_BRIGHT);
      }
      return;
    }

    // ── DIST — tap to refresh reading ──
    if (activeTab == 5 && t_y >= CONTENT_Y && t_y < CONTENT_BOT) {
      updateDistanceDisplay();
      return;
    }

    delay(150);
  }
}