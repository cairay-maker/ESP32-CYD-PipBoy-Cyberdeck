#include <Arduino.h>
#include <TFT_eSPI.h>
#include <SPIFFS.h>
#include <TJpg_Decoder.h>

TFT_eSPI tft = TFT_eSPI();

// ── Color Palette ────────────────────────────────────────
#define PIP_BRIGHT   0x07E0   // bright green  - active elements
#define PIP_MID      0x03E0   // mid green     - borders, lines
#define PIP_DIM      0x0380   // dim green     - inactive tabs
#define PIP_DARK     0x0200   // dark green    - scanlines, fills
#define PIP_DARKEST  0x0100   // very dark     - tab backgrounds
#define PIP_BLACK    0x0000   // black         - background
#define PIP_AMBER    0xFD20   // amber         - highlights

// ── Layout Constants ─────────────────────────────────────
#define SCREEN_W     320
#define SCREEN_H     240
#define TAB_H        36
#define BOTTOM_H     28
#define CONTENT_Y    (TAB_H + 1)
#define CONTENT_H    (SCREEN_H - TAB_H - BOTTOM_H - 0)
#define CONTENT_BOT  (SCREEN_H - BOTTOM_H - 1)

// ── Tabs ─────────────────────────────────────────────────
const char* TAB_LABELS[] = { "STAT", "TIMER", "PHOTO", "GAME", "RADIO" };
const int   TAB_COUNT    = 5;
const int   TAB_W        = SCREEN_W / TAB_COUNT;  // 64px each

int activeTab = 0;

// ── Uptime ───────────────────────────────────────────────
unsigned long bootTime = 0;

// ── SPIFFS image list ────────────────────────────────────
String imageList[20];
int IMAGE_COUNT  = 0;
int currentImage = 0;

// ── TJpg callback ────────────────────────────────────────
bool tft_output_fullsize(int16_t x, int16_t y, uint16_t w, uint16_t h, uint16_t* bitmap) {
  if (y >= tft.height() || x >= tft.width()) return false;
  tft.startWrite();
  tft.setAddrWindow(x, y, w, h);
  tft.pushColors(bitmap, w * h, false);
  tft.endWrite();
  return true;
}

bool tft_output(int16_t x, int16_t y, uint16_t w, uint16_t h, uint16_t* bitmap) {
  // Clip to content area only
  if (y + h <= CONTENT_Y) return true;   // above content — skip but continue
  if (y >= CONTENT_BOT)   return false;  // below content — stop
  if (x >= SCREEN_W)      return false;  // off right edge — stop

  tft.startWrite();
  tft.setAddrWindow(x, y, w, h);
  tft.pushColors(bitmap, w * h, false);
  tft.endWrite();
  return true;
}

// ── Calibration ──────────────────────────────────────────
uint16_t calData[5];

void calibrateTouch() {
  tft.fillScreen(PIP_BLACK);
  tft.setTextColor(PIP_BRIGHT, PIP_BLACK);
  tft.drawCentreString("PIPBOY 2026", 160, 70, 4);
  tft.setTextColor(PIP_BRIGHT, PIP_BLACK);
  tft.drawCentreString("TOUCH CALIBRATION", 160, 110, 2);
  tft.drawCentreString("TAP EACH MARKER ACCURATELY", 160, 130, 2);
  delay(1500);
  tft.calibrateTouch(calData, PIP_BRIGHT, PIP_BLACK, 15);
  tft.setTouch(calData);
  tft.fillScreen(PIP_BLACK);
  tft.setTextColor(PIP_BRIGHT, PIP_BLACK);
  tft.drawCentreString("CALIBRATION COMPLETE", 160, 110, 2);
  tft.setTextColor(PIP_BRIGHT, PIP_BLACK);
  tft.drawCentreString("INITIALIZING SYSTEMS...", 160, 130, 2);
  delay(1000);
}

// ── Draw Tab Bar ─────────────────────────────────────────
void drawTabs() {
  // Background bar
  tft.fillRect(0, 0, SCREEN_W, TAB_H, PIP_BLACK);

  for (int i = 0; i < TAB_COUNT; i++) {
    int x = i * TAB_W;
    bool active = (i == activeTab);

    if (active) {
      // Active tab — filled bright green
      tft.fillRect(x + 1, 1, TAB_W - 2, TAB_H - 1, PIP_DARK);
      tft.drawRect(x + 1, 1, TAB_W - 2, TAB_H - 1, PIP_BRIGHT);
      // Top accent line
      tft.drawFastHLine(x + 2, 1, TAB_W - 4, PIP_BRIGHT); //used to be PIP_AMBER but it was too bright and clashed with the green text
      tft.setTextColor(PIP_BRIGHT, PIP_DARK);
    } else {
      // Inactive tab — dark with dim outline
      tft.fillRect(x + 1, 3, TAB_W - 2, TAB_H - 3, PIP_BLACK);
      tft.drawRect(x + 1, 3, TAB_W - 2, TAB_H - 3, PIP_DARKEST);
      tft.setTextColor(PIP_DIM, PIP_BLACK);
    }

    // Tab label
    int labelX = x + TAB_W / 2;
    int labelY = active ? 11 : 13;
    tft.drawCentreString(TAB_LABELS[i], labelX, labelY, active ? 2 : 2);

    // Divider between tabs
    if (i < TAB_COUNT - 1) {
      tft.drawFastVLine(x + TAB_W, 2, TAB_H - 4, PIP_DARK);
    }
  }

  // Bottom border of tab bar
  tft.drawFastHLine(0, TAB_H, SCREEN_W, PIP_MID);
  // Double line for style
  tft.drawFastHLine(0, TAB_H - 1, SCREEN_W, PIP_DARK);

  int ax = activeTab * TAB_W;
  tft.drawFastHLine(ax + 1, TAB_H - 1, TAB_W - 2, PIP_BRIGHT);
}

// ── Draw Bottom Bar ───────────────────────────────────────
void drawBottomBar() {
  // Separator line
  tft.drawFastHLine(0, CONTENT_BOT, SCREEN_W, PIP_MID);
  tft.drawFastHLine(0, CONTENT_BOT + 1, SCREEN_W, PIP_DARK);

  // Background
  tft.fillRect(0, CONTENT_BOT + 2, SCREEN_W, BOTTOM_H, PIP_BLACK);

  // Left — branding
  tft.setTextColor(PIP_BRIGHT, PIP_BLACK);
  tft.drawString("PIP-BOY 2026", 16, CONTENT_BOT + 8, 2);
  tft.setTextColor(PIP_BRIGHT, PIP_BLACK);
  tft.drawString(" * MAKER CAI *", 86, CONTENT_BOT + 8, 2);

  // Decorative left corner
  tft.setTextColor(PIP_MID, PIP_BLACK);
  tft.drawString(">>", 2, CONTENT_BOT + 8, 2);
}

// ── Update Uptime ─────────────────────────────────────────
void updateUptime() {
  unsigned long up = (millis() - bootTime) / 1000;
  int h = up / 3600;
  int m = (up % 3600) / 60;
  int s = up % 60;

  char buf[12];
  sprintf(buf, "%02d:%02d:%02d", h, m, s);

  tft.setTextColor(PIP_BRIGHT, PIP_BLACK);
  tft.drawString(buf, 232, CONTENT_BOT + 8, 2);

  // Uptime label
  tft.setTextColor(PIP_MID, PIP_BLACK);
  tft.drawString("UP:", 210, CONTENT_BOT + 8, 2);
}

// ── Draw Corner Brackets ──────────────────────────────────
void drawCornerBrackets() {
  int x1 = 4, y1 = CONTENT_Y + 4;
  int x2 = SCREEN_W - 4, y2 = CONTENT_BOT - 4;
  int len = 12;

  // Top-left
  tft.drawFastHLine(x1, y1, len, PIP_MID);
  tft.drawFastVLine(x1, y1, len, PIP_MID);

  // Top-right
  tft.drawFastHLine(x2 - len, y1, len, PIP_MID);
  tft.drawFastVLine(x2, y1, len, PIP_MID);

  // Bottom-left
  tft.drawFastHLine(x1, y2, len, PIP_MID);
  tft.drawFastVLine(x1, y2 - len, len, PIP_MID);

  // Bottom-right
  tft.drawFastHLine(x2 - len, y2, len, PIP_MID);
  tft.drawFastVLine(x2, y2 - len, len, PIP_MID);

  // Inner corner dots for style
  tft.drawPixel(x1 + len, y1 + len, PIP_DIM);
  tft.drawPixel(x2 - len, y1 + len, PIP_DIM);
  tft.drawPixel(x1 + len, y2 - len, PIP_DIM);
  tft.drawPixel(x2 - len, y2 - len, PIP_DIM);
}

// ── Draw Scanlines ────────────────────────────────────────
void drawScanlines() {
  for (int y = CONTENT_Y + 2; y < CONTENT_BOT; y += 3) {
    tft.drawFastHLine(5, y, SCREEN_W - 10, PIP_DARK);
  }
}

// ── Draw Content Area Placeholder ────────────────────────
void drawContentPlaceholder() {
  tft.fillRect(0, CONTENT_Y, SCREEN_W, CONTENT_H, PIP_BLACK);

  // Center text
  tft.setTextColor(PIP_DARK, PIP_BLACK);
  tft.drawCentreString("[ VAULT BOY ]", 160, CONTENT_Y + CONTENT_H / 2 - 10, 2);
  tft.setTextColor(PIP_DARKEST + 0x0060, PIP_BLACK);
  tft.drawCentreString("INSERT IMAGE", 160, CONTENT_Y + CONTENT_H / 2 + 10, 1);

  drawScanlines();
  drawCornerBrackets();
}

// ── Draw STAT Screen ─────────────────────────────────────
void drawStatScreen() {
  tft.fillRect(0, CONTENT_Y, SCREEN_W, CONTENT_H, PIP_BLACK);

  // ← ADD THIS: draw vaultboy as background
  TJpgDec.drawFsJpg(0, CONTENT_Y, "/vaultboy_splash.jpg");  // draws from 0,0, clipped by tft_output

  tft.setTextColor(PIP_BRIGHT, PIP_BLACK);
  tft.drawString("S.P.E.C.I.A.L", 10, CONTENT_Y + 8, 2);

  tft.drawFastHLine(10, CONTENT_Y + 26, 140, PIP_MID);

  const char* stats[] = { "STR", "PER", "END", "CHR", "INT", "AGI", "LCK" };
  const int   vals[]  = {  8,     7,     9,     6,     10,    7,     8   };

  for (int i = 0; i < 7; i++) {
    int y = CONTENT_Y + 34 + i * 15;
    tft.setTextColor(PIP_DIM, PIP_BLACK);
    tft.drawString(stats[i], 10, y, 1);
    tft.setTextColor(PIP_BRIGHT, PIP_BLACK);

    // Bar
    int barW = vals[i] * 10;
    tft.fillRect(46, y + 1, barW, 8, PIP_DARK);
    tft.fillRect(46, y + 1, barW - 4, 6, PIP_MID);
    tft.drawRect(46, y, barW, 9, PIP_DIM);

    // Value
    char vbuf[4];
    sprintf(vbuf, "%02d", vals[i]);
    tft.setTextColor(PIP_BRIGHT, PIP_BLACK);
    tft.drawString(vbuf, 150, y, 1);
  }

  tft.setTextColor(PIP_DIM, PIP_BLACK);
  tft.drawString("LVL 10  XP 2400/3000", 10, CONTENT_BOT - 24, 1);

  // XP bar
  tft.drawRect(10, CONTENT_BOT - 14, 140, 8, PIP_DIM);
  tft.fillRect(11, CONTENT_BOT - 13, 112, 6, PIP_MID);

  drawCornerBrackets();
}

// ── Draw TIMER Screen ────────────────────────────────────
void drawTimerScreen() {
  tft.fillRect(0, CONTENT_Y, SCREEN_W, CONTENT_H, PIP_BLACK);
  tft.setTextColor(PIP_DIM, PIP_BLACK);
  tft.drawCentreString("STOPWATCH", 160, CONTENT_Y + 10, 2);
  tft.drawFastHLine(60, CONTENT_Y + 28, 200, PIP_DIM);
  tft.setTextColor(PIP_BRIGHT, PIP_BLACK);
  tft.drawCentreString("00:00", 160, CONTENT_Y + 50, 7);
  tft.setTextColor(PIP_DIM, PIP_BLACK);
  tft.drawCentreString("[ START ]   [ STOP ]   [ RESET ]", 160, CONTENT_BOT - 24, 1);
  drawCornerBrackets();
}

// ── Draw PHOTO Screen ────────────────────────────────────
void drawPhotoScreen() {
  tft.fillRect(0, CONTENT_Y, SCREEN_W, CONTENT_H, PIP_BLACK);
  if (IMAGE_COUNT == 0) {
    tft.setTextColor(PIP_DIM, PIP_BLACK);
    tft.drawCentreString("NO IMAGES FOUND", 160, CONTENT_Y + CONTENT_H / 2, 2);
  } else {
    TJpgDec.drawFsJpg(0, CONTENT_Y, imageList[currentImage].c_str());
  }
  //drawScanlines();
  drawCornerBrackets();
}

// ── Draw GAME Screen ─────────────────────────────────────
void drawGameScreen() {
  tft.fillRect(0, CONTENT_Y, SCREEN_W, CONTENT_H, PIP_BLACK);
  tft.setTextColor(PIP_BRIGHT, PIP_BLACK);
  tft.drawCentreString("GAMES", 160, CONTENT_Y + 10, 2);
  tft.drawFastHLine(60, CONTENT_Y + 28, 200, PIP_DIM);
  tft.setTextColor(PIP_DIM, PIP_BLACK);
  tft.drawCentreString("COMING SOON", 160, CONTENT_Y + CONTENT_H / 2 - 10, 2);
  tft.setTextColor(PIP_DARKEST + 0x0060, PIP_BLACK);
  tft.drawCentreString("SNAKE  PONG  BREAKOUT", 160, CONTENT_Y + CONTENT_H / 2 + 15, 1);
  drawCornerBrackets();
}

// ── Draw RADIO Screen ────────────────────────────────────
void drawRadioScreen() {
  tft.fillRect(0, CONTENT_Y, SCREEN_W, CONTENT_H, PIP_BLACK);
  tft.setTextColor(PIP_BRIGHT, PIP_BLACK);
  tft.drawCentreString("RADIO", 160, CONTENT_Y + 10, 2);
  tft.drawFastHLine(60, CONTENT_Y + 28, 200, PIP_DIM);
  tft.setTextColor(PIP_DIM, PIP_BLACK);
  tft.drawCentreString("GALAXY NEWS RADIO", 160, CONTENT_Y + 50, 2);
  tft.setTextColor(PIP_DARKEST + 0x0060, PIP_BLACK);
  tft.drawCentreString("SIGNAL SEARCHING...", 160, CONTENT_Y + 80, 1);

  // Fake signal bars
  for (int i = 0; i < 8; i++) {
    int barH = (i + 1) * 6;
    int barX = 100 + i * 16;
    int barY = CONTENT_Y + 120 - barH;
    uint16_t col = (i < 3) ? PIP_MID : PIP_DARKEST;
    tft.fillRect(barX, barY, 10, barH, col);
    tft.drawRect(barX, barY, 10, barH, PIP_DIM);
  }

  tft.setTextColor(PIP_DIM, PIP_BLACK);
  tft.drawCentreString("WIFI REQUIRED", 160, CONTENT_BOT - 20, 1);
  drawCornerBrackets();
}

// ── Draw Active Screen ────────────────────────────────────
void drawActiveScreen() {
  switch (activeTab) {
    case 0: drawStatScreen();  break;
    case 1: drawTimerScreen(); break;
    case 2: drawPhotoScreen(); break;
    case 3: drawGameScreen();  break;
    case 4: drawRadioScreen(); break;
  }
}

// ── Full Redraw ───────────────────────────────────────────
void drawAll() {
  tft.fillScreen(PIP_BLACK);

  // Outer border
  tft.drawRect(0, 0, SCREEN_W, SCREEN_H, PIP_MID);

  drawTabs();
  drawBottomBar();
  updateUptime();
  drawActiveScreen();
}

// ── SPIFFS scan ───────────────────────────────────────────
void buildImageList() {
  File root = SPIFFS.open("/");
  File file = root.openNextFile();
  while (file && IMAGE_COUNT < 20) {
    String name = String(file.name());
    if (name.endsWith(".jpg") || name.endsWith(".JPG")) {
      if (!name.startsWith("/")) name = "/" + name;
      imageList[IMAGE_COUNT++] = name;
    }
    file = root.openNextFile();
  }
  Serial.printf("Found %d images\n", IMAGE_COUNT);
}

// ─────────────────────────────────────────────────────────
void setup() {
  Serial.begin(115200);

  tft.init();
  tft.setRotation(1);
  tft.invertDisplay(false);
  tft.fillScreen(PIP_BLACK);

  pinMode(27, OUTPUT);
  digitalWrite(27, HIGH);

  if (!SPIFFS.begin(true)) {
    Serial.println("SPIFFS failed");
  } else {
    TJpgDec.setCallback(tft_output);
    TJpgDec.setSwapBytes(true);
    buildImageList();
  }

  calibrateTouch();

  bootTime = millis();
  drawAll();
}

// ─────────────────────────────────────────────────────────
unsigned long lastUptimeUpdate = 0;

void loop() {
  // Update uptime every second
  if (millis() - lastUptimeUpdate > 1000) {
    lastUptimeUpdate = millis();
    updateUptime();
  }

  // Touch handling
  uint16_t t_x = 0, t_y = 0;
  bool pressed = tft.getTouch(&t_x, &t_y);

  if (pressed) {
    Serial.printf("Touch X: %d Y: %d\n", t_x, t_y);

    // Check tab bar touch
    if (t_y < TAB_H) {
      int tappedTab = t_x / TAB_W;
      if (tappedTab >= 0 && tappedTab < TAB_COUNT && tappedTab != activeTab) {
        activeTab = tappedTab;
        drawTabs();
        drawActiveScreen();
      }
    }

    // PHOTO tab — tap content to next image
    if (activeTab == 2 && t_y >= CONTENT_Y && t_y < CONTENT_BOT && IMAGE_COUNT > 0) {
      while (tft.getTouch(&t_x, &t_y)) delay(10);
      currentImage = (currentImage + 1) % IMAGE_COUNT;
      drawPhotoScreen();
    }

    delay(150); // debounce
  }
}